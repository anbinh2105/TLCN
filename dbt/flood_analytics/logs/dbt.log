WITH ordered AS (
    SELECT
        location_key,
        hour_start,
        LAG(hour_start) OVER (
            PARTITION BY location_key
            ORDER BY hour_start
        ) AS previous_hour
    FROM "iceberg"."marts_staging"."stg_fact_hydrology"
)
SELECT
    COUNT_IF(
        previous_hour IS NOT NULL
        AND date_diff('hour', previous_hour, hour_start) <> 1
    ) AS non_consecutive_pairs,
    COUNT(*) AS total_rows
FROM ordered
  
  limit 5
