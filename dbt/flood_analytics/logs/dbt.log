    create table "iceberg"."marts"."mart_rainfall"
      
      
    as (
      

select
    hour_start,
    date_key,
    time_key,
    location_key,

    -- Hourly rainfall
    rainfall_mm,

    -- Accumulated rainfall
    rainfall_valid_hours_3h,
