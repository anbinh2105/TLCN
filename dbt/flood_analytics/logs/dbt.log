SELECT
    COUNT_IF(
        present_source_count < 0
        OR present_source_count > 5
        OR usable_source_count < 0
        OR usable_source_count > present_source_count
        OR missing_source_count <> 5 - present_source_count
        OR unusable_source_count <> present_source_count - usable_source_count
        OR all_five_present IS DISTINCT FROM (present_source_count = 5)
        OR all_five_usable IS DISTINCT FROM (usable_source_count = 5)
    ) AS invalid_quality_rows
FROM "iceberg"."marts"."mart_data_quality"
  
  limit 5
