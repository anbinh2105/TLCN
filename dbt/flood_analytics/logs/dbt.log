        water_level_valid_hours_24h = 24
    ) AS complete_24h_windows,

    COUNT_IF(
        water_level_valid_hours_24h < 24
    ) AS incomplete_24h_windows,

    COUNT_IF(
        (water_level_valid_hours_24h = 24
            AND water_level_max_24h_m IS NULL)
        OR
        (water_level_valid_hours_24h < 24
            AND water_level_max_24h_m IS NOT NULL)
    ) AS invalid_24h_results

FROM "iceberg"."marts"."mart_water_level"
  
  limit 5
