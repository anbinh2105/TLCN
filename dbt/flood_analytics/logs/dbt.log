    rainfall_valid_hours_12h,
    rainfall_sum_12h_mm,

    rainfall_valid_hours_24h,
    rainfall_sum_24h_mm,

    -- Data quality
    rainfall_quality_flag,
    rainfall_present,
    rainfall_usable

from "iceberg"."marts_intermediate"."int_rainfall_metrics"
    )
