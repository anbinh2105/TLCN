FROM apache/hive:3.1.3

USER root

# Remove old PostgreSQL JDBC drivers bundled with Hive image
RUN rm -f /opt/hive/lib/postgresql-*.jar

# Install PostgreSQL JDBC driver supporting SCRAM
COPY postgresql-42.7.4.jar /opt/hive/lib/postgresql-42.7.4.jar

# S3A dependencies matching Hadoop 3.1.0
COPY v3/lib/hadoop-aws-3.1.0.jar /opt/hive/lib/hadoop-aws-3.1.0.jar
COPY v3/lib/aws-java-sdk-bundle-1.11.271.jar /opt/hive/lib/aws-java-sdk-bundle-1.11.271.jar

# MinIO / S3A configuration
COPY core-site.xml /opt/hadoop/etc/hadoop/core-site.xml

USER hive